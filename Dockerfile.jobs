# =============================================================================
# Dockerfile.jobs — Dedicated image for one-shot jobs (the `delegator-jobs` CLI)
# =============================================================================
# Runs a single command and exits, e.g. `docker run <image> invitation-cleanup`,
# started by an external scheduler (cron job, Dokploy schedule). Unlike
# Dockerfile.tasks it is not a long-running scheduler. Assumes the database is
# already migrated and needs nothing but DATABASE_URL.
# =============================================================================

FROM oven/bun:1.3-slim AS base

# ---------------------------------------------------------------------------
# Stage 1: bundle the CLI with tsdown
# ---------------------------------------------------------------------------
FROM base AS builder
WORKDIR /build

COPY package.json bun.lock tsconfig.json svelte.config.js tsdown.jobs.config.ts ./
COPY src ./src
COPY static ./static

RUN bun install --frozen-lockfile

# Generate path aliases (.svelte-kit/tsconfig.json) that tsconfig.json extends
RUN bunx svelte-kit sync

RUN bun run build:jobs

# ---------------------------------------------------------------------------
# Stage 2: minimal runtime
# ---------------------------------------------------------------------------
FROM base AS runner
WORKDIR /run

# Apply OS security updates (see Dockerfile.tasks); CI passes the current date so
# this layer is rebuilt daily.
ARG OS_UPDATES_DATE
RUN echo "OS updates as of ${OS_UPDATES_DATE:-unknown}" \
  && apt-get update \
  && apt-get -y upgrade \
  && rm -rf /var/lib/apt/lists/*

# Only `pg` stays external in the bundle (optional native bindings). Keep in sync with package.json.
RUN bun add pg@^8.23.0

COPY --from=builder /build/jobsOut ./

USER bun
ENV NODE_ENV=production

# One-shot CLI job runner, not a long-running service, so no active health check applies.
HEALTHCHECK NONE

ENTRYPOINT ["bun", "./cli.js"]
