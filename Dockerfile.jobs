# =============================================================================
# Dockerfile.jobs — Dedicated image for one-shot jobs (the `delegator-jobs` CLI)
# =============================================================================
# Stays running and does nothing by itself: a scheduler execs `delegator-jobs <job>`
# into it (Dokploy application schedules). A one-off run is
# `docker run --rm <image> delegator-jobs <job>`. Assumes the database is already
# migrated. Each job reads only the variables it uses: DATABASE_URL,
# plus the app's SMTP_* / REDIS_URL and APP_URL for send-emails, and so on.
# =============================================================================

FROM oven/bun:1.3-slim AS base

# ---------------------------------------------------------------------------
# Stage 1: bundle the CLI with tsdown
# ---------------------------------------------------------------------------
FROM base AS builder
WORKDIR /build

COPY package.json bun.lock tsconfig.json vite.config.ts tsdown.jobs.config.ts ./
COPY patches ./patches
COPY src ./src
COPY static ./static
# Paraglide compiles the messages the mails are written in into the bundle
COPY project.inlang ./project.inlang
COPY messages ./messages

RUN bun install --frozen-lockfile

# Generate path aliases (.svelte-kit/tsconfig.json) that tsconfig.json extends
RUN bunx svelte-kit sync

RUN bun run build:jobs

# ---------------------------------------------------------------------------
# Stage 2: minimal runtime
# ---------------------------------------------------------------------------
FROM base AS runner
WORKDIR /run

# Apply OS security updates (see Dockerfile.tasks); CI passes the current date so
# this layer is rebuilt daily.
ARG OS_UPDATES_DATE
RUN echo "OS updates as of ${OS_UPDATES_DATE:-unknown}" \
  && apt-get update \
  && apt-get -y upgrade \
  && rm -rf /var/lib/apt/lists/*

# Only `pg` stays external in the bundle (optional native bindings). Keep in sync with package.json.
RUN bun add pg@^8.23.0

COPY --from=builder /build/jobsOut ./

# The CLI on the PATH as `delegator-jobs`, what the scheduler execs
RUN printf '#!/bin/sh\nexec bun /run/cli.js "$@"\n' > /usr/local/bin/delegator-jobs \
  && chmod +x /usr/local/bin/delegator-jobs

USER bun
ENV NODE_ENV=production

# Only waits for the scheduler's exec, so there is nothing to health check.
HEALTHCHECK NONE

# The base image's entrypoint runs this as given, as it does `delegator-jobs <job>`
CMD ["sleep", "infinity"]
