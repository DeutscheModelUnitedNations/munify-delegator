FROM oven/bun:1-slim AS base

FROM base AS builder
WORKDIR /build
COPY package.json bun.lock ./
COPY patches ./patches
RUN bun install --frozen-lockfile
COPY . .
RUN bunx svelte-kit sync && bun run build:jobs

FROM base AS release
ARG OS_UPDATES_DATE
RUN apt-get update \
	&& apt-get upgrade -y --no-install-recommends \
	&& apt-get clean \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN bun add pg@^8.23.0
COPY --from=builder /build/jobsOut ./
RUN printf '#!/bin/sh\nexec bun /app/cli.js "$@"\n' > /usr/local/bin/delegator-jobs \
	&& chmod +x /usr/local/bin/delegator-jobs

ENV NODE_ENV=production
USER bun
HEALTHCHECK NONE
CMD ["sleep", "infinity"]
