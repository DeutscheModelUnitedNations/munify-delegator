{
	"$schema": "./node_modules/fallow/schema.json",
	// `$houdini` (root alias and the route-relative `./$houdini` type imports)
	// resolves into the gitignored, generated `.houdini` directory, which fallow
	// never sees. Without this every route importing generated types would be
	// reported as an unresolved import.
	"ignoreUnresolvedImports": ["$houdini", "$houdini/*", "**/$houdini"],
	"rules": {
		// This project deliberately keeps runtime packages in devDependencies
		// (see CLAUDE.md); SvelteKit bundles them at build time. The rule fires
		// on ~80 packages here and is noise rather than signal.
		"dev-dependencies-in-production": "off"
	}
}
