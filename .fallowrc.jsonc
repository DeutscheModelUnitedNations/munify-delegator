{
	"$schema": "./node_modules/fallow/schema.json",
	// `$houdini` (root alias and the route-relative `./$houdini` type imports)
	// resolves into the gitignored, generated `.houdini` directory, which fallow
	// never sees. Without this every route importing generated types would be
	// reported as an unresolved import.
	"ignoreUnresolvedImports": ["$houdini", "$houdini/*", "**/$houdini"],
	// Both are used without ever being imported, so fallow cannot see them.
	// Verified before suppressing; do not "clean these up".
	//   typst         - src/routes/api/pdf/+server.ts executes the binary at
	//                   node_modules/.bin/typst to render PDFs at runtime.
	//   houdini-svelte - declared as a plugin in houdini.config.js; nothing else
	//                   depends on it, so removing it breaks `houdini generate`.
	"ignoreDependencies": ["typst", "houdini-svelte"],
	// Standalone scripts run directly with `bun <file>` (see CLAUDE.md), so no
	// framework plugin or package.json script declares them as entry points.
	// The conference dashboard lazy-loads these via `{#await import(...)}` in its
	// markup, which fallow does not trace, so they (and everything they import)
	// would otherwise be reported as unused files. Entries are globs, so the
	// `(authenticated)` and `[conferenceId]` route segments are written as `*`.
	"entry": [
		"prisma/seed/dev/seed.ts",
		"src/lib/components/Dashboard/CalendarSection.svelte",
		"src/routes/*/dashboard/*/stages/Common/Certificate.svelte",
		"src/routes/*/dashboard/*/stages/Supervisor/Supervisor.svelte"
	],
	// SvelteKit route modules only export what the framework consumes. Houdini adds
	// `_houdini_load` and `_<Query>Variables`, which its generated load functions read,
	// so fallow sees no importer and reported every one of them as unused.
	"ignoreExports": [
		{ "file": "src/routes/**/+page.ts", "exports": ["*"] },
		{ "file": "src/routes/**/+layout.ts", "exports": ["*"] }
	],
	"health": {
		"thresholdOverrides": [
			{
				"files": ["prisma/seed/dev/seed.ts"],
				// CRAP is driven by missing test coverage, which a one-off dev
				// seed script will never have.
				"maxCrap": 500,
				"reason": "Dev seed script: never covered by tests, CRAP score is not meaningful"
			}
		]
	},
	"rules": {
		// This project deliberately keeps runtime packages in devDependencies
		// (see CLAUDE.md); SvelteKit bundles them at build time. The rule fires
		// on ~80 packages here and is noise rather than signal.
		"dev-dependencies-in-production": "off"
	}
}
