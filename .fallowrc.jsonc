{
	"$schema": "./node_modules/fallow/schema.json",
	// Generated code: rumble writes the typed client on every dev server start. It is not edited by
	// hand, so its own findings and clones are hidden - but it stays in the module graph, since the
	// generated client is what imports `$lib/api/client.ts`. (Paraglide's output is gitignored,
	// which fallow skips anyway.)
	"ignoreFindings": ["src/lib/api/rumbleClient/**"],
	// The Listmonk API types are generated by openapi-typescript from Listmonk's spec (the file
	// says so in its header), so their repeated response shapes are not ours to deduplicate.
	"duplicates": {
		"ignore": ["src/lib/api/rumbleClient/**", "src/tasks/apis/listmonk/listmonk-paths.d.ts"]
	},
	// Runtime roots no SvelteKit convention declares: the background tasks are bundled separately
	// by scripts/tasksBuild.ts and run as their own process, and the scripts are run by hand
	// (`bun run …`) or from CI.
	"entry": ["src/tasks/index.ts", "scripts/**/*.ts"],
	// Reached in ways the static graph does not follow: the certificate and the dashboard calendar
	// through `{#await import('…')}` in a template (Certificate.svelte in the stages, CalendarSection
	// in sections/DashboardConferenceOverview.svelte), the task shims through the aliases
	// scripts/tasksBuild.ts maps `$app/environment` and `$env/dynamic/private` to.
	"dynamicallyLoaded": [
		"src/routes/**/stages/Common/Certificate.svelte",
		"src/lib/components/dashboard/CalendarSection.svelte",
		"src/tasks/shims/*.ts"
	],
	// Used without ever being imported, so fallow cannot see them. Verified before suppressing;
	// do not "clean these up".
	//   typst              - src/routes/api/pdf/+server.ts executes the binary at
	//                        node_modules/.bin/typst to render PDFs at runtime.
	//   pg                 - the driver drizzle-orm/node-postgres loads for `drizzle(DATABASE_URL)`.
	//   @typescript/native - TypeScript 7, providing the `tsc` binary `bun run typecheck` runs
	//                        (svelte-check needs the TypeScript 6 `typescript` package).
	"ignoreDependencies": ["typst", "pg", "@typescript/native"],
	"rules": {
		// This project deliberately keeps runtime packages in devDependencies
		// (see CLAUDE.md); SvelteKit bundles them at build time. The rule fires
		// on ~80 packages here and is noise rather than signal.
		"dev-dependencies-in-production": "off"
	},
	"health": {
		"thresholdOverrides": [
			{
				// The dev seed builds every conference stage for clicking around by hand. It has no
				// tests and never will, so CRAP there only measures that. Only the CRAP ceiling moves:
				// complexity findings still count. (main gave the Prisma seed the same exemption.)
				"files": ["src/api/db/seed-dev/**", "src/api/db/seed-data/**"],
				"maxCrap": 1000,
				"reason": "Dev seed scripts: never covered by tests, so CRAP is not meaningful"
			}
		]
	}
}
