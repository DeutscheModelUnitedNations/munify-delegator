	"scripts": {
		"add-translation": "bun run scripts/add_new_translation.ts",
		"build": "bun run build:app && bun run build:compute && bun run build:tasks",
		"build:app": "vite build",
		"build:compute": "tsdown --config tsdown.compute.config.ts",
		"build:tasks": "tsdown --config tsdown.tasks.config.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"coverage": "vitest run --coverage && bun scripts/mergeCoverage.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:reset": "bun ./src/api/db/reset.ts",
		"db:seed:dev": "bun ./src/api/db/seedDev.ts",
		"dev:accounts": "bun ./scripts/writeOidcMockUsers.ts",
		"db:nuke": "docker compose -f ./dev.docker-compose.yml down -v && docker compose -f ./dev.docker-compose.yml up -d --wait && bun run db:migrate",
		"dev": "concurrently \"bun run dev:server\" \"bun run dev:docker\"",
		"dev:docker": "docker compose -f ./dev.docker-compose.yml up",
		"dev:server": "svelte-kit sync && vite --host",
		"fallow": "bun scripts/mergeCoverage.ts && fallow --coverage coverage/coverage-final.json",
		"fallow:audit": "bun scripts/mergeCoverage.ts && fallow audit --coverage coverage/coverage-final.json",
		"fallow:health": "bun scripts/mergeCoverage.ts && fallow health --score --coverage coverage/coverage-final.json",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"i18n:check": "i18n-check --source \"de\" --locales ./messages --format \"i18next\"",
		"i18n:translate": "inlang machine translate --project project.inlang",
		"i18n:validate": "inlang validate --project project.inlang",
		"install-git-hooks": "bunx lefthook install",
		"lint": "eslint . --cache --cache-strategy content",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:coverage": "bun scripts/e2eCoverage.ts"
	},
	"type": "module",
	"version": "0.0.1",
	"patchedDependencies": {
		"@magidoc/plugin-svelte-marked@7.0.0": "patches/@magidoc%2Fplugin-svelte-marked@7.0.0.patch",
