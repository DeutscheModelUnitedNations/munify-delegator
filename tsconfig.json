{
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"module": "ESNext",
		"noImplicitAny": false,
		// Imports name a module without its extension (`#lib/helpers/countryCodes`). TypeScript
		// applies `package.json`'s `imports` literally and finds no file there; `paths` it completes
		// like a relative import. Keep in step with `imports`.
		"paths": {
			"#api/*": ["./src/api/*"],
			"#assets/*": ["./src/assets/*"],
			"#lib/*": ["./src/lib/*"]
		},
		"rootDirs": [".", "./.svelte-kit/types"],
		"sourceMap": true,
		"strict": true,
		"target": "ESNext"
	},
	"extends": "$app/tsconfig",
	"include": ["src", "vite.config.ts", "playwright.config.ts"]
}
