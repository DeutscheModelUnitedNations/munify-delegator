@@ -99,8 +99,14 @@ function makeGraphQLQueryRequest({ queryName, schema, input, client, enableSubsc
 	})));
 	const subscriberReady = svelteReactivityReady.then(() => {
 		svelteSubscriber = createSubscriber((update) => {
+			// Announce every emission on the next task. urql emits synchronously - a replayed value
+			// on subscribe, or a cache hit fanned out to every operation with the same key when some
+			// other query is issued - and that code often runs inside a `$derived`, where calling
+			// `update()` throws `state_unsafe_mutation` and leaves the page unrendered. A microtask
+			// is not enough: Svelte flushes its batches in microtasks too, and an update landing
+			// between them trips its "Batch has scheduled roots" invariant.
 			const unsub = observable.subscribe((_d) => {
-				update();
+				setTimeout(update, 0);
 			});
 			return () => unsub.unsubscribe();
 		});
